# Canonical site origin — used for metadataBase, canonical URLs and OG tags.
# Set this to the real domain once it is live (e.g. https://designoasis.ng).
# Leave unset on Vercel and the deploy's own URL is used, so preview links
# share correctly.
NEXT_PUBLIC_SITE_URL=

# --- Later ---
# Enquiry delivery. Until this is set, /api/enquiries logs and returns ok.
# RESEND_API_KEY=
# ENQUIRY_TO_EMAIL=
